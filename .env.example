# ChatMol Lab desktop development configuration

# Choose one model provider. Values are intentionally blank.
# LLM_PROVIDER=openai
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=

# Optional OpenAI-compatible endpoint (Ollama, vLLM, LM Studio, etc.).
# LLM_BASE_URL=http://localhost:11434
# LLM_API_KEY=
# MODEL=
# FAST_MODEL=

# === Deployment mode ===
# local  (default) — desktop app and `npm run dev`: no account, the server mints
#                    a session for the single local workspace principal.
# hosted           — the ChatMol-operated service (accounts, wallet, quotas).
# CHATMOL_DEPLOYMENT=local
# Address `npm run start` binds. Loopback by default: local mode has no
# accounts, so the server must not be reachable from the network.
# CHATMOL_BIND_HOST=127.0.0.1

# Local development workspace and SQLite database.
WORKSPACE_DIR=/tmp/chatmol-workspace
DATABASE_URL="file:./dev.db"

# Generate a local value with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with: openssl rand -base64 32"
NEXTAUTH_URL="http://localhost:3000"

# Optional scientific providers.
# CHATMOL_API_KEY=            # ChatMol Bio API key (cmol_...) for background GPU jobs
# CHATMOL_API_URL=https://bio-api.cloudmol.org
# NVIDIA_API_KEY=
# MODAL_TOKEN_ID=
# MODAL_TOKEN_SECRET=

# Optional local ProteinMPNN installation.
# MPNN_PYTHON=/path/to/python
# MPNN_SCRIPT=/path/to/ProteinMPNN/protein_mpnn_run.py

NODE_ENV=development
