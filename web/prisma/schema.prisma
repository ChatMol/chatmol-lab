generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "darwin-arm64", "darwin", "linux-musl-arm64-openssl-3.0.x", "windows"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  status        String    @default("approved")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  chatSessions     ChatSession[]
  pendingApprovals PendingApproval[]
  userSettings     UserSettings?
}

model UserSettings {
  id                   String   @id @default(cuid())
  userId               String   @unique
  nvidiaApiKey         String?
  systemPrompt         String?
  wemolUsername        String?
  wemolPassword        String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model ApiUsage {
  id           String   @id @default(cuid())
  userId       String?
  sessionId    String?
  provider     String
  model        String?
  tool         String?
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  durationMs   Int      @default(0)
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([provider])
  @@index([createdAt])
}

model ChatSession {
  id               String   @id
  userId           String?
  title            String   @default("New Research Session")
  messages         String   @default("[]")
  plan             String   @default("[]")
  artifacts        String   @default("[]")
  compactions      String   @default("[]")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user             User?             @relation(fields: [userId], references: [id], onDelete: Cascade)
  pendingApprovals PendingApproval[]

  @@index([userId])
  @@index([updatedAt])
}

model PendingApproval {
  id          String    @id @default(cuid())
  sessionId   String
  userId      String?
  commandHash String
  toolName    String?
  status      String    @default("pending")
  createdAt   DateTime  @default(now())
  expiresAt   DateTime
  approvedAt  DateTime?
  consumedAt  DateTime?

  chatSession ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user        User?       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([sessionId, status])
  @@index([commandHash])
  @@index([expiresAt])
}
